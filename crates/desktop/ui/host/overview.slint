// SPDX-License-Identifier: AGPL-3.0-only
// This computer, at a glance: who it is to the world (Remote ID, relay), what is running, how
// the stream is being made, who is here, and what just happened.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Host, App } from "../state.slint";
import { Button } from "../widgets/button.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { Rise, Card, Disc, SectionLabel, Title, Small, Mono, MetaCell, Divider } from "../widgets/surface.slint";
import { StatusPill, LinkWords, Tone } from "../widgets/status.slint";

component Hero inherits Rectangle {
    border-radius: Theme.r4;
    background: Theme.surface-1;
    wash := Rectangle {
        border-radius: Theme.r4;
        background: @linear-gradient(120deg, Theme.accent.with-alpha(0.20) 0%, Theme.mauve.with-alpha(0.12) 55%, transparent 100%);
    }
    VerticalLayout {
        padding: 24px;
        spacing: 18px;
        HorizontalLayout {
            spacing: 18px;
            Disc { size: 64px; icon: Icons.monitor; hue: Theme.accent; }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: Host.computer-name;
                    color: Theme.bright;
                    font-family: Theme.display-font;
                    font-size: 34px;
                    font-weight: 700;
                    letter-spacing: -0.8px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Mono { text: Host.remote-id != "" ? "Remote ID " + Host.remote-id : "No Remote ID yet"; color: Theme.dim; font-size: 12.5px; vertical-alignment: center; }
                    if Host.remote-id != "": Rectangle {
                        width: 24px; height: 24px; border-radius: 12px;
                        background: ct.has-hover ? Theme.surface-3 : transparent;
                        Icon { path: Icons.copy; color: Theme.dim; size: 14px; }
                        ct := TouchArea { mouse-cursor: pointer; clicked => { App.copy(Host.remote-id); } }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: start;
                StatusPill { text: Host.relay-words; tone: Host.relay-tone; motion: Host.relay-motion; }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            for s in Host.meta: MetaCell {
                height: 78px;
                key: s.key;
                value: s.value;
                sub: s.sub;
                tone: s.tone;
            }
        }
    }
}

component NoDaemon inherits Card {
    tone: "bad";
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        Title { text: "No wado daemon is running here."; font-size: 16px; }
        Small {
            text: "Nothing can reach this computer until one is. Devices, pairing and settings below still work — they are files the daemon reads when it starts.";
            font-size: 13.5px;
        }
        HorizontalLayout {
            alignment: start;
            Button { kind: "primary"; text: "Start the daemon"; icon: Icons.power; clicked => { Host.start-daemon(); } }
        }
    }
}

component LiveCard inherits Card {
    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        HorizontalLayout {
            SectionLabel { text: "LIVE"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if Host.encoder-words != "": StatusPill { text: Host.encoder-words; tone: Host.encoder-tone; }
        }
        GridLayout {
            spacing: 10px;
            Row {
                for s[i] in Host.live: MetaCell {
                    height: 74px;
                    key: s.key;
                    value: s.value;
                    sub: s.sub;
                }
            }
        }
        if Host.encoder-detail != "": Small { text: Host.encoder-detail; }
    }
}

component PeopleCard inherits Card {
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            SectionLabel { text: "DEVICES"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { kind: "ghost"; h: 32px; text: "Manage"; icon: Icons.right; icon-after: true; clicked => { App.host-page = 1; } }
        }
        if Host.devices.length == 0: Small { text: "No device is paired yet. Pair one to reach this computer from anywhere."; }
        for d[i] in Host.devices: HorizontalLayout {
            spacing: 12px;
            height: 44px;
            Disc { size: 32px; letters: d.letters; hue: d.hue; }
            VerticalLayout {
                alignment: center;
                Title { text: d.name; font-size: 13.5px; }
                Small { text: d.summary; font-size: 11.5px; overflow: elide; wrap: no-wrap; }
            }
            VerticalLayout {
                alignment: center;
                LinkWords { text: d.link-words; tone: d.link-tone; motion: d.link-motion; font-size: 12px; }
            }
        }
    }
}

component ActivityCard inherits Card {
    VerticalLayout {
        padding: 18px;
        spacing: 8px;
        HorizontalLayout {
            SectionLabel { text: "WHAT JUST HAPPENED"; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { kind: "ghost"; h: 32px; text: "Logs"; icon: Icons.right; icon-after: true; clicked => { App.host-page = 4; } }
        }
        if Host.activity.length == 0: Small { text: "Quiet. Pairings, files, shells and settings changes show up here."; }
        for l in Host.activity: HorizontalLayout {
            spacing: 12px;
            Mono { text: l.time; color: Theme.dim; width: 64px; }
            Rectangle {
                width: 6px;
                VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Tone.of(l.tone); } }
            }
            Text {
                text: l.msg;
                color: Theme.text;
                font-family: Theme.body-font;
                font-size: 13px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

export component OverviewPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            padding-top: 24px;
            spacing: 14px;
            Rise { order: 0; Hero { } }
            if !Host.daemon-up: Rise { order: 1; NoDaemon { } }
            Rise {
                order: 2;
                HorizontalLayout {
                    spacing: 14px;
                    LiveCard { horizontal-stretch: 3; }
                    PeopleCard { horizontal-stretch: 2; }
                }
            }
            Rise { order: 3; ActivityCard { } }
        }
    }
}
