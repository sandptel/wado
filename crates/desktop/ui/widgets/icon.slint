export component Icon {
    in property <string> path;
    in property <color> color: #ffffff;
    in property <length> size: 20px;
    in property <length> stroke: 1.8px;
    width: size;
    height: size;
    Path {
        width: parent.width;
        height: parent.height;
        commands: root.path;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: root.stroke;
        stroke-line-cap: round;
    }
}
