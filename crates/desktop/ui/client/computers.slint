// SPDX-License-Identifier: AGPL-3.0-only
// Other wado computers this app knows: a card each, with the relay's word on whether it is up.
// Tapping a card opens its page; the trailing ▶ goes straight to the desktop.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Client, App, ComputerRow } from "../state.slint";
import { Button } from "../widgets/button.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { Rise, Card, Disc, SectionLabel, Title, Small, Mono, PageHead } from "../widgets/surface.slint";
import { LinkWords, Badge } from "../widgets/status.slint";
import { Field } from "../widgets/field.slint";

component ComputerCard inherits Rectangle {
    in property <ComputerRow> c;
    in property <int> index;
    height: 84px;
    border-radius: Theme.r3;
    background: t.has-hover ? Theme.surface-2 : Theme.surface-1;
    border-width: 1px;
    border-color: Theme.line;
    transform-scale: t.pressed ? 0.98 : 1.0;
    animate transform-scale { duration: t.pressed ? Theme.dur-press : Theme.dur; easing: t.pressed ? cubic-bezier(0.32, 0.72, 0, 1) : cubic-bezier(0.34, 1.56, 0.64, 1); }
    animate background { duration: Theme.dur; }
    accessible-role: button;
    accessible-label: c.name + ", " + c.status-words;
    t := TouchArea { mouse-cursor: pointer; clicked => { Client.open(root.index); } }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout { alignment: center; Disc { size: 46px; letters: root.c.letters; hue: root.c.hue; } }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.c.name;
                    color: Theme.bright;
                    font-family: Theme.display-font;
                    font-size: 17px;
                    font-weight: 700;
                    overflow: elide;
                }
                if root.c.here: VerticalLayout { alignment: center; Badge { text: "THIS COMPUTER"; tone: "mauve"; } }
            }
            Mono { text: root.c.pretty-id + " · " + root.c.relay-host; color: Theme.dim; font-size: 11.5px; }
            LinkWords { text: root.c.status-words; tone: root.c.status-tone; motion: root.c.status-motion; font-size: 12.5px; }
        }
        VerticalLayout {
            alignment: center;
            go := Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: root.c.online ? (gt.has-hover ? Theme.accent : Theme.accent-tint) : Theme.surface-2;
                opacity: root.c.online ? 1 : 0.45;
                transform-scale: gt.pressed ? 0.9 : 1.0;
                animate transform-scale { duration: Theme.dur; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                animate background { duration: Theme.dur; }
                accessible-role: button;
                accessible-label: "Open the desktop of " + root.c.name;
                Icon {
                    path: Icons.play;
                    color: root.c.online ? (gt.has-hover ? Theme.on-accent : Theme.accent) : Theme.dim;
                    size: 20px;
                    stroke: 2px;
                }
                gt := TouchArea {
                    enabled: root.c.online;
                    mouse-cursor: pointer;
                    clicked => { Client.launch(root.index, "desktop"); }
                }
            }
        }
    }
}

component AddCard inherits Rectangle {
    in-out property <bool> open;
    property <string> name;
    property <string> id;
    property <string> relay;
    min-height: lay.preferred-height;
    border-radius: Theme.r3;
    background: open ? Theme.surface-1 : (t.has-hover ? Theme.surface-1 : transparent);
    border-width: 1.5px;
    border-color: open ? Theme.line : Theme.surface-3;
    clip: true;
    animate background { duration: Theme.dur; }
    t := TouchArea { enabled: !root.open; mouse-cursor: pointer; clicked => { root.open = true; } }
    lay := VerticalLayout {
    if !root.open: HorizontalLayout {
        height: 64px;
        alignment: center;
        spacing: 10px;
        VerticalLayout { alignment: center; Icon { path: Icons.plus; color: Theme.accent; size: 20px; } }
        Text { text: "Add a computer"; color: Theme.accent; font-family: Theme.body-font; font-size: 14px; font-weight: 600; vertical-alignment: center; }
    }
    if root.open: VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Title { text: "Add a computer"; font-size: 15px; }
        Small { text: "Its Remote ID is on its own screen: run wado there, or open its console. A connect link (from a QR) works too."; }
        HorizontalLayout {
            spacing: 10px;
            Field { horizontal-stretch: 1; label: "Name"; placeholder: "Name — e.g. Studio"; text <=> root.name; }
            Field { horizontal-stretch: 2; label: "Remote ID or link"; mono: true; placeholder: "Remote ID 123-456-789, or a connect link"; text <=> root.id; }
        }
        Field { label: "Relay"; mono: true; placeholder: "Relay — leave empty for the public one"; text <=> root.relay; }
        if Client.add-error != "": Small { text: Client.add-error; color: Theme.bad; }
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Button { kind: "ghost"; text: "Cancel"; clicked => { root.open = false; } }
            Button {
                kind: "primary";
                text: "Add";
                icon: Icons.plus;
                enabled: root.id != "";
                clicked => {
                    Client.add(root.name, root.id, root.relay);
                    if Client.add-error == "" { root.open = false; root.name = ""; root.id = ""; root.relay = ""; }
                }
            }
        }
    }
    }
}

export component ComputersPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 28px;
            padding-top: 24px;
            spacing: 10px;
            Rise {
                order: 0;
                HorizontalLayout {
                    PageHead {
                        title: "Your computers";
                        subtitle: "Other computers running wado. Status comes from the relay every few seconds.";
                    }
                    VerticalLayout {
                        alignment: end;
                        Button { kind: "ghost"; text: "Check now"; icon: Icons.refresh; clicked => { Client.refresh(); } }
                    }
                }
            }
            Rectangle { height: 6px; }
            for c[i] in Client.computers: Rise { order: i + 1; ComputerCard { c: c; index: i; } }
            Rise { order: Client.computers.length + 1; AddCard { } }
        }
    }
}
