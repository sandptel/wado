// Appearance: the base16 scheme (the same list as the web client's), corner radius and motion.
// A popover over the rail — it floats, so it casts the Popover shadow.

import { Theme } from "../theme.slint";
import { App, SchemeRow } from "../state.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { Segmented } from "../widgets/toggle.slint";
import { SectionLabel, Title, Mono } from "../widgets/surface.slint";

component Swatch inherits Rectangle {
    in property <SchemeRow> s;
    in property <bool> on;
    callback clicked();
    height: 50px;
    border-radius: Theme.r2;
    background: s.ground;
    border-width: on ? 2px : 1px;
    border-color: on ? Theme.accent : Theme.line;
    transform-scale: t.pressed ? 0.95 : 1.0;
    animate transform-scale { duration: Theme.dur; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    accessible-role: button;
    accessible-label: s.name;
    accessible-item-selected: on;
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.s.accent; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.s.mauve; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.s.good; }
        }
        Text {
            text: root.s.name;
            color: root.s.text;
            font-family: Theme.mono-font;
            font-size: 10.5px;
            overflow: elide;
        }
    }
}

export component AppearancePanel inherits Rectangle {
    in-out property <bool> open;
    property <float> k: open ? 1 : 0;
    animate k { duration: open ? Theme.dur-sheet : Theme.dur * 1.4; easing: cubic-bezier(0.32, 0.72, 0, 1); }
    visible: k > 0.001;

    // Click outside closes.
    TouchArea { clicked => { root.open = false; } }
    card := Rectangle {
        x: 16px;
        y: root.height - self.height - 96px + 16px * (1 - root.k);
        width: 400px;
        height: lay.preferred-height;
        opacity: root.k;
        border-radius: Theme.r3;
        background: Theme.surface-1;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 18px;
        drop-shadow-color: #000000aa;
        TouchArea { }
        lay := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Title { text: "Appearance"; font-size: 16px; }
            SectionLabel { text: "SCHEME"; }
            GridLayout {
                spacing: 8px;
                for s[i] in App.schemes: Swatch {
                    row: i / 3;
                    col: mod(i, 3);
                    s: s;
                    on: s.name == App.scheme;
                    clicked => { App.pick-scheme(s.name); }
                }
            }
            SectionLabel { text: "CORNERS"; }
            Segmented {
                h: 38px;
                options: ["Sharp", "Round", "Pill"];
                index: Theme.radius-mode;
                picked(i) => { App.pick-radius(i); }
            }
            SectionLabel { text: "MOTION"; }
            Segmented {
                h: 38px;
                options: ["Full", "Reduced", "Off"];
                index: Theme.motion;
                picked(i) => { App.pick-motion(i); }
            }
        }
    }
}
