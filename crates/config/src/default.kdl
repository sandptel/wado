// wado daemon configuration. Every line below is commented out and shows the built-in
// default, so this file changes nothing until you edit it. Changes are picked up live where
// they can be; `wado validate` checks the file without starting anything.
//
// Precedence: WADO_* environment variables > this file (and its includes, later wins) > defaults.

server {
    // listen "127.0.0.1:8080"         // direct-mode control address; keep it on localhost
    // relay "wss://relay.example"     // set to use relay mode
    // instance "1"                    // identity within a pool of daemons
    // remote-id "123456789"           // pin the Remote ID (default: generated once, saved)
    // udp-slice 0                     // which 100-port UDP range this daemon uses
    // turn { url "turn:turn.example:3478"; user "wado"; pass "secret"; }
    // public-relay "https://relay.example"   // the relay as a phone reaches it — for `wado qr`
    // client-url "https://sandptel.github.io/wado/"
}

security {
    // trust-first-device #true        // with an empty trust list, trust the first device
    // join "ask"                      // "ask" (a connected device approves) | "open" (anyone, let in once)
    // new-device "host"               // what a new device may do: files-ro|files-rw shells settings host
}

stream {
    // encoder "auto"                  // "auto" (client decides) | "hardware" | "software"
    // max-fps 120
    // max-bitrate 20000               // kbps
    // max-width 3840
    // max-height 2160
}

session {
    // app-cpu-weight 50               // cgroup CPU weight for session apps; 0 = off
    // atspi "/nix/store/…-at-spi2-core"
    // env { GDK_SCALE "1"; }
    // autostart "foot"
    // audio #true                     // own audio output, streamed; off = apps play here
    // audio-bitrate 96                // kbps, Opus
}

shells {
    // enabled #true
    // program "/run/current-system/sw/bin/fish"
}

files {
    // enabled #true
    // root "~"                        // one per tree a device may browse; "/" only if written
    // deny "~/Private"                // refused inside a root (plus ~/.ssh ~/.gnupg ~/.config/wado
    //                                 // ~/.local/share/keyrings, always)
    // hidden #false                   // list dotfiles
    // follow-symlinks "inside"        // "inside" (while they stay in the root) | "never"
    // rate-with-video 40              // Mbps cap on downloads while video is live; 0 = none
    // reserve-mib 1024                // refuse an upload that would leave less free
}

binds {
    // mod "super"                     // what Mod means: super | alt | ctrl | ctrl+alt
    // Mod+Q "close-window"            // actions: close-window maximize minimize focus-next back
    // Mod+Tab "focus-next"
}

gestures {
    // swipe-3-up "app-drawer"         // also: control-centre keyboard back focus-next
    // swipe-3-down "control-centre"   //       close-window maximize minimize none
    // swipe-3-left "back"
    // swipe-3-right "focus-next"
}

// window-rule {
//     match app-id="steam"            // app-id is exact; title="…" matches anywhere
//     open-maximized #true
// }
