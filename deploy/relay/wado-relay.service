# systemd unit for wado-relay on a public host, behind deploy/relay/Caddyfile.
#
#   sudo install -m755 target/release/wado-relay /usr/local/bin/
#   sudo cp deploy/relay/wado-relay.service /etc/systemd/system/
#   sudo systemctl enable --now wado-relay
#
# Restarting it is safe at any time: it keeps nothing on disk. Daemons redial within ~5 s,
# phones within seconds, and each lands back on its own desktop (stable instance ids). Video
# never goes through the relay, so a stream in progress does not even notice.

[Unit]
Description=wado relay (signaling broker)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wado-relay --bind 127.0.0.1:4000 --trust-proxy
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
